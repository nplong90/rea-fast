{
  "schema_version": 1,
  "goal": "M1 — safe, explicitly partial REA-Fast merge",
  "policy": "A task is DONE only after every required platform and every check has verified evidence on the same commit. A green CI job alone does not complete the goal.",
  "tasks": [
    {
      "id": "G0-routing-contract",
      "title": "Freeze honest catalog route contracts",
      "depends_on": [],
      "platforms": ["linux", "win32"],
      "checks": [{ "name": "contract-drift", "argv": ["node", "tests/acceptance/contracts.mjs", "--check"], "expect_stdout": "Verified 245 versioned contracts" }]
    },
    {
      "id": "S1-extraction-race",
      "title": "Prove extraction cannot escape a private root during concurrent renames",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux", "win32"],
      "checks": [
        { "name": "concurrent-directory-swap", "argv": ["cargo", "test", "--locked", "security_io::tests::concurrent_directory_swap_cannot_escape_extraction_capability", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "visible-root-swap", "argv": ["cargo", "test", "--locked", "security_io::tests::replacing_visible_root_after_open_cannot_redirect_writes", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "exclusive-output", "argv": ["cargo", "test", "--locked", "security_io::tests::exclusive_outputs_never_clobber", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "asar-extraction", "argv": ["cargo", "test", "--locked", "asar::tests::extracts_all_with_integrity_and_contradictions", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "bundle-extraction", "argv": ["cargo", "test", "--locked", "bundle::tests::unbundles_webpack_jsonp_push", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "sourcemap-extraction", "argv": ["cargo", "test", "--locked", "sourcemap::tests::extracts_sourcemap_v3_json", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "tauri-extraction", "argv": ["cargo", "test", "--locked", "tauri::tests::extracted_assets_use_exclusive_output_capability", "--", "--exact"], "expect_stdout": "1 passed" }
      ]
    },
    {
      "id": "S2a-bounded-text-readers",
      "title": "Bound source-text readers and fail closed on partial source or secret scans",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux", "win32"],
      "checks": [
        { "name": "mcp-text-paths", "argv": ["cargo", "test", "--locked", "mcp::tests::oversized_mcp_text_paths_fail_closed_without_partial_results", "--", "--exact"], "expect_stdout": "1 passed" },
        { "name": "external-sourcemap", "argv": ["cargo", "test", "--locked", "sourcemap::tests::oversized_external_sourcemap_is_rejected_before_extraction", "--", "--exact"], "expect_stdout": "1 passed" }
      ]
    },
    {
      "id": "S2b-http-response-bounds",
      "title": "Reject oversized provider HTTP responses, even if the prefix is valid JSON",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux", "win32"],
      "checks": [
        { "name": "http-response-one-extra-byte", "argv": ["cargo", "test", "--locked", "tcp_driver::tests::oversized_http_response_cannot_pass_as_valid_json_prefix", "--", "--exact"], "expect_stdout": "1 passed" }
      ]
    },
    {
      "id": "S2-bounded-io",
      "title": "Finish repository-wide direct I/O allocation and decompression audit",
      "depends_on": ["S2a-bounded-text-readers", "S2b-http-response-bounds"],
      "platforms": ["linux", "win32"],
      "checks": [],
      "blocker": "Remaining direct readers and resource stress corpus need a complete reviewed inventory"
    },
    {
      "id": "S3-unix-process-tree",
      "title": "Timeout kills descendants on Unix",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux"],
      "checks": [{ "name": "unix-descendants", "argv": ["cargo", "test", "--locked", "dynamic_bridge::tests::test_optional_bridge_timeout_cleans_up_descendants", "--", "--exact"], "expect_stdout": "1 passed" }]
    },
    {
      "id": "S3-windows-process-tree",
      "title": "Timeout kills actual descendants on Windows",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["win32"],
      "checks": [{ "name": "windows-descendants", "argv": ["cargo", "test", "--locked", "dynamic_bridge::tests::test_optional_bridge_timeout_cleans_up_descendants_windows", "--", "--exact"], "expect_stdout": "1 passed" }]
    },
    {
      "id": "C1-mcp-native-routing",
      "title": "Exercise all 63 native-labeled routes with real MCP calls",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux", "win32"],
      "checks": [{ "name": "mcp-63", "argv": ["node", "tests/acceptance/mcp-matrix.mjs", "--rust-bin", "${REA_FAST_BIN}"], "expect_stdout": "\"fixture_exercised\":63" }]
    },
    {
      "id": "C2-provider-offline",
      "title": "Provider-free routes fail closed without inventing positive evidence",
      "depends_on": ["G0-routing-contract"],
      "platforms": ["linux", "win32"],
      "checks": [{ "name": "provider-51", "argv": ["node", "tests/acceptance/provider-offline.mjs", "--rust-bin", "${REA_FAST_BIN}"], "expect_stdout": "\"checked\":51" }]
    },
    {
      "id": "C2-provider-live",
      "title": "Test supported external providers with success, malformed and timeout scenarios",
      "depends_on": ["C2-provider-offline"],
      "platforms": ["linux", "win32"],
      "checks": [],
      "blocker": "Need reproducible ADB/Rizin/Frida/JEB fixtures, or explicit demotion to unavailable before this gate can pass"
    },
    {
      "id": "E1-upstream-semantics",
      "title": "Prove matched upstream semantics for every claimed equivalent subsystem",
      "depends_on": ["C1-mcp-native-routing"],
      "platforms": ["linux"],
      "checks": [],
      "blocker": "Pinned JS subset passes; complete Electron Evidence, ASAR, native and mobile comparison is still missing"
    },
    {
      "id": "F1-adversarial-corpus",
      "title": "Run deterministic hostile corpus across parsers and transports",
      "depends_on": ["S1-extraction-race", "S2-bounded-io", "S3-unix-process-tree", "S3-windows-process-tree"],
      "platforms": ["linux", "win32"],
      "checks": [],
      "blocker": "Fuzz corpus, timeout, crash and memory ceilings are not yet fully encoded"
    },
    {
      "id": "B1-five-workload-parity-benchmark",
      "title": "Benchmark five fact-equivalent workloads with CPU, RSS and wall time",
      "depends_on": ["E1-upstream-semantics"],
      "platforms": ["linux"],
      "checks": [],
      "blocker": "Only the pinned JS subset comparison exists; four more comparable workloads plus process-family metrics are missing"
    },
    {
      "id": "R1-independent-merge-review",
      "title": "Independent final-head review, CI and user-controlled merge decision",
      "depends_on": ["S1-extraction-race", "S2-bounded-io", "S3-unix-process-tree", "S3-windows-process-tree", "C1-mcp-native-routing", "C2-provider-live", "E1-upstream-semantics", "F1-adversarial-corpus", "B1-five-workload-parity-benchmark"],
      "platforms": ["linux", "win32"],
      "checks": [],
      "blocker": "Independent review and explicit final authorization required; no automatic merge"
    }
  ]
}
